NODE_ENV=production
PORT=4000
# Keep browser-facing PHP, React, and /api on one host so the host-only
# silver_session cookie reaches every route. Reverse-proxy /api to port 4000.
CLIENT_ORIGIN=https://your-cinema.example
PHP_CLIENT_ORIGIN=https://your-cinema.example/SilverVillage
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=silver_screen
MYSQL_USER=sbm_app
MYSQL_PASSWORD=replace-with-a-secret
# Hosted MySQL/TiDB: keep verified TLS enabled in both Node and Apache/PHP.
MYSQL_SSL=true
MYSQL_SSL_CA=/etc/ssl/certs/ca-certificates.crt
SESSION_TTL_MINUTES=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-cinema.example/api/auth/google/callback
GOOGLE_OWNER_EMAILS=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
