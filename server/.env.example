NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PHP_CLIENT_ORIGIN=http://localhost/SilverVillage
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=silver_screen
MYSQL_USER=root
MYSQL_PASSWORD=
# Keep false for local XAMPP. Set true for a hosted database requiring TLS.
# Both Node and Apache/PHP must receive these settings in their process environment.
MYSQL_SSL=false
# Optional CA bundle path. TLS always verifies the certificate and host.
# Linux example: /etc/ssl/certs/ca-certificates.crt
MYSQL_SSL_CA=
SESSION_TTL_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GOOGLE_OWNER_EMAILS=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional server-side EmailJS token. Leave blank unless your EmailJS setup requires it.
EMAILJS_PRIVATE_KEY=
