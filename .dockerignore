# Explicit build context: credentials, work files and local dependencies stay out.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!index.php
!.htaccess
!server/
!server/package.json
!server/src/
!server/src/**
!client/
!client/package.json
!base/
!base/**
!php/
!php/**
!deployment/
!deployment/start.sh
!deployment/apache.conf
!deployment/init-database.mjs
!database/
!database/submission/
!database/submission/silver_screen.sql
base/database/**
server/src/*.test.js
**/.DS_Store
**/.env
**/.env.*
**/config.local.php
**/node_modules/**
